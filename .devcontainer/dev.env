# Spring default configuration. Loads application .yml or .property files from DX_CONFIG env var.
SPRING_CONFIG_NAME=application,template

# Remote VS Code debugging
JAVA_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,address=0.0.0.0:8000,server=y,suspend=n

# Examples to use to conenct to a postgres container
# DATABASE_HOST: postgres
# DATABASE_NAME: myappdatabase
# DATABASE_PORT: 5432

# DX_CONFIG is set to contents of ./config
DX_
